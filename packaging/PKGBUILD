# Maintainer: mdx contributors
#
# Arch Linux recipe for the mdx workspace. It builds the three binaries
# (`mdx`, `mdx-mcp`, `mdx-gui`) from the workspace release build and installs the
# desktop entry, the icon and the systemd user unit.
#
# `url` and `license` mirror the `[workspace.package]` table in Cargo.toml.
# `source` is the tag tarball for `pkgver` on that same repository.
#
# Requirements the package does not declare because it is the packager's call:
#
#   * Rust 1.95 or newer: the workspace is edition 2024 and pins
#     `rust-version = "1.95"` in Cargo.toml, so the `rust`/`cargo` from the Arch
#     repositories must be at least that version.
#   * `mdx-gui` links against a GL/EGL stack and a window system: it needs
#     `libglvnd`, `libx11`, `libxkbcommon` and `libwayland` available at build
#     and run time. `libegl`, `libgl`, `libx11`, `libxkbcommon` and `libwayland`
#     come from those packages.
#   * CJK text in a PDF needs a CJK font on the host (see `optdepends`);
#     `scripts/install-fonts.sh` prints the `--font` argument to pass instead.

pkgname=mdx
pkgver=0.1.0
pkgrel=1
pkgdesc="Markdown to PDF and HTML, in one binary (CLI, MCP server and desktop shell)"
arch=('x86_64')
url="https://github.com/shubing-joe/mdx"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('noto-fonts-cjk: CJK PDF text')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# The tag tarball is generated by the forges on demand, so no fixed digest can be
# shipped here. Pin it at release time.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  # `--locked` keeps the build on the committed Cargo.lock; `--workspace` builds
  # the CLI, the MCP server and the GUI in one pass.
  cargo build --release --locked --workspace
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/mdx "$pkgdir/usr/bin/mdx"
  install -Dm755 target/release/mdx-mcp "$pkgdir/usr/bin/mdx-mcp"
  install -Dm755 target/release/mdx-gui "$pkgdir/usr/bin/mdx-gui"

  install -Dm644 packaging/mdx.desktop "$pkgdir/usr/share/applications/mdx.desktop"
  install -Dm644 packaging/mdx.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/mdx.svg"

  install -Dm644 packaging/mdx-mcp.service "$pkgdir/usr/lib/systemd/user/mdx-mcp.service"

  # License texts are declared in Cargo.toml; install them under their own names
  # when the tree carries them, so the package is self-describing.
  local text
  for text in LICENSE LICENSE-MIT LICENSE-APACHE; do
    if [[ -f $text ]]; then
      install -Dm644 "$text" "$pkgdir/usr/share/licenses/$pkgname/$text"
    fi
  done
}
